{
  "name": "edgepost-mail",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Edgepost mail Worker: stores Email Routing mail in D1/R2 and sends via Email Sending, in the user's own Cloudflare account.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:bundle": "tsc --noEmit -p test/bundle/tsconfig.json && vitest run --config vitest.bundle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "postal-mime": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
